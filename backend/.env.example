# Flask Server Configuration
PORT=5000
SECRET_KEY=food_rescue_production_secret_key_change_in_production
JWT_EXPIRY_HOURS=72
DEBUG=False

# Database Configuration:
# Default: Local SQLite (persistent within the environment)
DATABASE_URL=sqlite:///food_waste.db

# Optional: To use managed PostgreSQL (e.g. Supabase, Neon, Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/food_waste_db

# Optional External API Keys:
OPENWEATHERMAP_API_KEY=
GOOGLE_MAPS_API_KEY=
